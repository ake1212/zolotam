# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Both values are compiled into the browser bundle and are safe to expose —
# the anon key identifies the project, it does not grant access. What each
# request may read or write is decided by the row level security policies in
# supabase/migrations/0001_init.sql.
#
# Never put the service_role key here. It bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
